[user]
	name = Tales Araujo
	email = talesaraujodossantos@gmail.com
[core]
	editor = nano
[alias]
        lg = log --graph --oneline --decorate --all
        st = status
        a  = add
        aa = add --all
        sf = diff --name-only
        c = commit -m
        ca = commit --amend
        can = commit --amend --no-edit
        ps = push
        pl = pull
        cob = checkout -b
        bv = branch -vv --color=always
        co = checkout
        sw = switch
        br = branch
        ci = commit
        cm = commit -m
        last = log -1 HEAD
        lol = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %C(green)%an%Creset %s %C(auto)%d' --date=short
        df = diff
        dc = diff --cached
        ap = add -p
        unstage = restore --staged
        rv = restore
        rh = reset --hard
        fp = fetch --prune
        psf = push --force-with-lease
        rb = rebase
        rbi = rebase -i
        cl = clone
        cp = cherry-pick
        undo = reset --soft HEAD~1
        uncommit = reset HEAD~1
        discard = reset --hard HEAD~1
[color]
        ui = auto
[status]
        branch = true
